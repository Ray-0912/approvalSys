# Flask
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=replace-db-user
DB_PASSWORD=replace-db-password
DB_NAME=approvalSys

# BioLife API
API_BASE_URL=http://127.0.0.1:8083
API_USERNAME=admin
API_PASSWORD=replace-api-password

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=replace-sender@example.com
SMTP_PASSWORD=replace-smtp-password
DEFAULT_NOTIFY_EMAIL=
